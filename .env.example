# Unified AICTE Portal Environment Variables
DEV_EMP_PASSWORDS="fd_emp:your_password,pgrc_emp:your_password,vig_emp:your_password"
RESET_DEV_PASSWORDS=false
SESSION_SECRET=your-random-session-secret-here
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_unified
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

