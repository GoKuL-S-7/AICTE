# ==========================================
# Unified AICTE Portal - Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Production Variables (e.g. Render)
# ------------------------------------------
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Persistent MongoDB URI (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aicte_unified?retryWrites=true&w=majority

# Strong cryptographic random secret for session encryption (at least 32 characters)
SESSION_SECRET=replace_with_a_secure_random_32_plus_char_secret

# Deployed Frontend URL (allowed in CORS & cookies)
# In production, set to your Vercel URL (e.g., https://unified-aicte-portal.vercel.app)
FRONTEND_URL=https://your-frontend-deployment.vercel.app

# Optional wildcard/suffix CORS domain (e.g. .vercel.app to allow preview builds)
ALLOWED_DOMAIN_SUFFIX=.vercel.app

# Persistent storage mount path for evidence file uploads
# On Render Disk: /opt/render/project/src/backend/uploads/evidence
PERSISTENT_STORAGE_DIR=/opt/render/project/src/backend/uploads/evidence

# AICTE Chatbot AI Key (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Frontend Production Variables (e.g. Vercel)
# ------------------------------------------
# Public URL of the deployed backend service (e.g. on Render)
BACKEND_URL=https://your-backend-deployment.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://your-backend-deployment.onrender.com

# ------------------------------------------
# Local Development Only (never set in production)
# ------------------------------------------
# DEV_EMP_PASSWORDS="fd_emp:your_password,pgrc_emp:your_password,vig_emp:your_password"
# DEV_INSTITUTION_USER=inst_dev
# DEV_INSTITUTION_PASSWORD=your_institution_password
# RESET_DEV_PASSWORDS=false

# ------------------------------------------
# Transactional Email (Optional)
# ------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="AICTE Complaint Portal" <no-reply@aicte-india.org>

