# Root-level gitignore for Unified AICTE Portal

# Local development credentials & secrets — NEVER commit
EMPLOYEE_CREDENTIALS.local
*.local
*.credentials

# Environment files
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
build/
.next/
out/
backend/dist/
frontend/.next/
frontend/out/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Upload storage & local attachments
backend/uploads/
uploads/

# Backups & database dumps
backend/backups/
backups/

# Scratch & temporary test scripts/data
scratch/
backend/scratch/
logout_screenshots/

# TypeScript build info
*.tsbuildinfo

# Vercel & cache
.vercel/
.turbo/
